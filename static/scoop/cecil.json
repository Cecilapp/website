{
  "description": "A simple and powerful content-driven static site generator.",
  "homepage": "https://cecil.app",
  "license": "EUPL-1.2",
  "pre_install": "Set-Content -Path \"$dir\\cecil.cmd\" -Value '@php \"%~dp0cecil.phar\" %*' -Encoding Ascii",
  "bin": "cecil.cmd",
  "notes": [
    "Run 'cecil' to get started",
    "Run 'scoop update cecil' instead of 'cecil self-update' to update"
  ],
  "suggest": {
    "PHP": ["php"]
  },
  "url": "https://cecil.app/download/9.30.0/cecil.phar",
  "version": "9.30.0",
  "hash": "sha1:39f1947544b67c464c1f5cf01856383865049efd",
  "checkver": {
    "url": "https://cecil.app/VERSION",
    "regex": "([\\d.]+)"
  },
  "autoupdate": {
    "url": "https://cecil.app/download/$version/cecil.phar",
    "hash": {
      "url": "$url.sha1"
    }
  }
}
