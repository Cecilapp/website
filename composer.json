{
  "require": {
    "cecil/theme-netlify": "^3.0",
    "cecil/theme-pwa": "^3.0",
    "cecil/theme-octicons": "^1.2",
    "cecil/theme-flexsearch": "^1.1",
    "aligny/tailwind-builder": "^1.2"
  },
  "config": {
    "allow-plugins": {
      "cecil/theme-installer": true
    }
  },
  "scripts": {
    "css:build": [
      "@putenv CECIL_ENV=production",
      "vendor/bin/tailwind-builder assets/css/tailwind.css -o assets/styles.css --minify"
    ],
    "build": "curl -sSOL https://cecil.app/build.sh && bash ./build.sh",
    "serve": [
      "@putenv XDEBUG_MODE=off",
      "cecil serve --config=config/dev.yml"
    ],
    "i18n:build": "node scripts/po2mo.js translations/messages.fr.po"
  }
}
