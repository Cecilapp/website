{#- breadcrumb: home icon > ancestor sections > current page -#}
{%- import 'macros/octicons.twig' as octicons -%}
{%- if page.type != 'homepage' ~%}
{%- if page.ancestors is defined -%}
  {%- set ancestors = page.ancestors|reverse -%}
{%- elseif page.section and page.type != 'section' -%}
  {%- set ancestors = [site.page(page.section)]|filter(p => p) -%}
{%- else -%}
  {%- set ancestors = [] -%}
{%- endif ~%}
<nav aria-label="{% trans %}Breadcrumb{% endtrans %}" class="mx-auto max-w-(--breakpoint-lg) mb-4 text-sm text-slate-500 dark:text-slate-400">
  <ol class="flex flex-nowrap items-center gap-1.5 min-w-0">
    <li class="flex items-center shrink-0">
      <a href="{{ url(site.home) }}" class="flex items-center hover:text-blue dark:hover:text-slate-200" title="{% trans %}Home{% endtrans %}" aria-label="{% trans %}Home{% endtrans %}">
        {{- octicons.svg('home', 16, 'w-4 h-4 shrink-0') -}}
      </a>
    </li>
    {%- for section in ancestors ~%}
    <li class="flex items-center gap-1.5 shrink-0 whitespace-nowrap">
      {{- octicons.svg('chevron-right', 12, 'w-3 h-3 shrink-0 opacity-50') }}
      <a href="{{ url(section) }}" class="hover:text-blue dark:hover:text-slate-200">{{ section.title }}</a>
    </li>
    {%- endfor ~%}
    <li class="flex items-center gap-1.5 min-w-0">
      {{- octicons.svg('chevron-right', 12, 'w-3 h-3 shrink-0 opacity-50') }}
      <span aria-current="page" class="text-darkblue dark:text-slate-300 truncate" title="{{ page.title }}">{{ page.title }}</span>
    </li>
  </ol>
</nav>
{%- endif -%}