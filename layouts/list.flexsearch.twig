{#-
  FlexSearch index: flat JSON array of documentation sections,
  consumed client-side by `partials/search-flexsearch.html.twig`.
  Experimental sections are skipped (same rule as the Algolia `NOT experimental:1` filter).
-#}
{%- set section, balise = 'documentation', 'h3' -%}
{%- macro dataset(id, page, title, description, content, href) ~%}
  {
    "id": "{{ id }}",
    "page": {{ page }},
    "title": {{ title }},
    "description": {{ description }},
    "content": {{ content }},
    "href": "{{ href }}"
  }
{%- endmacro -%}
[
{%- set is_first = true -%}
{%- for p in site.pages|filter(p => p.section == section)|sort_by_weight -%}
  {%- set sections = p.content|preg_split('/<' ~ balise ~ '[^>]*>/') -%}
  {%- if sections|length > 0 -%}
    {%- for section in sections -%}
      {%- if loop.index0 > 0 -%}
        {%- set section_content = sections[loop.index0]|split('</' ~ balise ~ '>') -%}
        {%- set title = section_content[0]|striptags|trim -%}
        {%- set anchor = title|lower|replace({':': '', '’': '', ' ': '-', '_': '-', '.': '-'}) -%}
        {%- set anchor = anchor|replace({'--': '-'}) -%}
        {%- set section_html = section_content[1]|default('') -%}
        {%- set content = section_html|striptags|trim -%}
        {%- set description = '' -%}
        {%- if section_html|trim starts with '<p>' -%}
        {%- set description = section_html|trim|split('</p>')|first|striptags|trim -%}
        {%- endif -%}
        {%- if 'Experimental' not in content -%}
          {%- if not is_first %},{% endif -%}
          {{- _self.dataset(
            p.id ~ '#' ~ anchor,
            p.title|json_encode,
            title|json_encode,
            description|json_encode,
            content|json_encode,
            url(p, {canonical: false})|trim('/', 'left') ~ '#' ~ anchor
          ) -}}
          {%- set is_first = false -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endfor ~%}
]
